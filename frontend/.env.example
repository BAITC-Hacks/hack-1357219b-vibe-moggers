# demo: browser-only, explicitly marked in the interface. api: real Go REST API.
VITE_DATA_MODE=api
VITE_API_BASE_URL=/api
# Vite development proxy. Restart the dev server after changing this value.
API_PROXY_TARGET=http://127.0.0.1:8080
# Never place an AI API key in a VITE_ variable. AI keys belong to Go only.
