{
  "name": "qadam-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src vite.config.ts index.html public/demo/prototype.html",
    "format:check": "prettier --check src vite.config.ts index.html public/demo/prototype.html"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@lucide/vue": "^1.47.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
